# =============================================================================
# Copy to ".env" and fill values. Never commit real ".env" to git.
# =============================================================================

# --- Database (Aura assistant loads tours; optional if you only need generic AI) ---
MONGO_URI=mongodb://localhost:27017/tours-travel

# --- Google Gemini (all AI: Aura chat, admin generate/enhance, weather, review summary) ---
# Create a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: comma-separated models, tried in order if one hits quota or errors
# GEMINI_MODELS=gemini-2.0-flash,gemini-2.5-flash

# --- Admin dashboard (login + Resend “send lead email” action) ---
ADMIN_PASSWORD=change_me_strong_password
# Must match cookie check in middleware; use a long random string in production
ADMIN_TOKEN_SECRET=change_me_random_secret

# --- Resend (contact form, enquiry API, admin “Send with Resend”) ---
# https://resend.com/api-keys — sender must be on a verified domain
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Konkan Arabia Hospitality Group <bookings@konkanarabiahospitalitygroup.com>"
EMAIL_TO=bookings@konkanarabiahospitalitygroup.com

# --- Cloudinary (destination images in admin) ---
# Server uses CLOUDINARY_CLOUD_NAME (see app/actions/destinations.ts)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional: if client code reads cloud name from the browser
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# --- Optional: partner logos on site ---
NEXT_PUBLIC_LOGO_DEV_TOKEN=your_token_here
