# Database
# Use your MongoDB connection string here
MONGO_URI=mongodb://localhost:27017/tours-travel

# AI Concierge & Services
# Get your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Resend — Email Notifications
# Get your key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Sender and receiver emails
EMAIL_FROM="Konkan Arabia Hospitality Group <bookings@konkanarabiahospitalitygroup.com>"
EMAIL_TO=bookings@konkanarabiahospitalitygroup.com

# Analytics & Extras
# logo.dev configuration for partner logos
NEXT_PUBLIC_LOGO_DEV_TOKEN=your_token_here

# Cloudinary — Media Management
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
